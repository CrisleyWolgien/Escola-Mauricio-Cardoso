APP_NAME=API EMEF Maurício Cardoso
ENVIRONMENT=development
# Em produção, use PostgreSQL: postgresql+psycopg://USUARIO:SENHA@HOST:5432/BANCO
DATABASE_URL=sqlite:///./escola.db
JWT_SECRET_KEY=gere-uma-chave-aleatoria-com-no-minimo-32-caracteres
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Produção: ["https://seu-projeto.vercel.app"]
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
# Defina somente no primeiro deploy de uma base nova e remova depois que a conta for criada.
INITIAL_ADMIN_NAME=Direção da escola
INITIAL_ADMIN_EMAIL=direcao@exemplo.com
INITIAL_ADMIN_PASSWORD=defina-uma-senha-inicial-com-no-minimo-12-caracteres
